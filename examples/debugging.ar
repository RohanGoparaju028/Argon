fn total(values: Array<i32>) -> i32 {
    let result = 0;
    for (let i = 0; i < values.length(); i++) {
        result += values[i]; // Put a breakpoint on this line.
    }
    return result;
}

fn main() -> i32 {
    let values = Array<i32>();
    values.push(10);
    values.push(20);
    values.push(12);
    let answer = total(values);
    println(answer);
    return 0;
}
