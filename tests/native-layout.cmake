cmake_minimum_required(VERSION 3.16)
string(RANDOM LENGTH 10 ALPHABET abcdef0123456789 nonce)
set(root "${WORK}/native-layout ${nonce}")
file(MAKE_DIRECTORY "${root}")
if(WIN32)
  set(suffix .exe)
endif()
function(command cwd expected)
  execute_process(COMMAND "${COMPILER}" ${ARGN} WORKING_DIRECTORY "${cwd}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  if(NOT status EQUAL expected)
    message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${status}\n${out}\n${err}")
  endif()
  string(REPLACE "\r\n" "\n" out "${out}")
  set(output "${out}" PARENT_SCOPE)
  set(diagnostic "${err}" PARENT_SCOPE)
endfunction()
command("${root}" 0 new app --cpp)
set(app "${root}/app")
if(NOT EXISTS "${app}/cpp/demo.hpp" OR NOT EXISTS "${app}/cpp/demo.cpp")
  message(FATAL_ERROR "new --cpp did not create the native folder")
endif()
command("${app}/src" 0 run)
if(NOT output STREQUAL "42\n" OR NOT EXISTS "${app}/argon-cxx/release/program.cpp" OR EXISTS "${app}/.argon")
  message(FATAL_ERROR "default native build layout failed: ${output}")
endif()
# A source listed explicitly and discovered in cpp must only be compiled once.
file(APPEND "${app}/Argon.toml" "\n[cpp]\nsources = [\"cpp/demo.cpp\"]\n")
command("${app}" 0 run)
# A module includes a header-only library; no .cpp implementation is needed.
file(MAKE_DIRECTORY "${app}/cpp/nested")
file(WRITE "${app}/cpp/nested/inline.hpp" "#pragma once\n#include <cstdint>\ninline std::int32_t inline_value(){return 7;}\n")
file(WRITE "${app}/src/support.ar" "cpp \"nested/inline.hpp\";pub extern cpp fn inline_value()->i32=\"inline_value\";")
file(WRITE "${app}/src/main.ar" "cpp \"demo.hpp\";import support;cpp \"cmath\";extern cpp fn root(x:f64)->f64=\"std::sqrt\";fn main()->i32{unsafe{println(support.inline_value());println(root(81.0));}return 0;}")
command("${app}" 0 run)
if(NOT output STREQUAL "7\n9\n")
  message(FATAL_ERROR "module or system/header-only include failed: ${output}")
endif()
# Local cpp headers precede configured include directories.
file(MAKE_DIRECTORY "${app}/other")
file(WRITE "${app}/other/choice.hpp" "#error wrong include search order\n")
file(WRITE "${app}/cpp/choice.hpp" "#pragma once\n#include <cstdint>\ninline std::int32_t chosen(){return 12;}\n")
file(APPEND "${app}/Argon.toml" "include_dirs = [\"other\"]\n")
file(WRITE "${app}/src/main.ar" "cpp \"choice.hpp\";cpp \"choice.hpp\";extern cpp fn chosen()->i32=\"chosen\";fn main()->i32{unsafe{println(chosen());}return 0;}")
command("${app}" 0 run)
if(NOT output STREQUAL "12\n")
  message(FATAL_ERROR "native header precedence failed")
endif()
# C sources compile as C11, with C linkage exposed by their header.
file(WRITE "${app}/cpp/nested/cvalue.h" [=[
#pragma once
#include <stdint.h>
#ifdef __cplusplus
extern "C" {
#endif
int32_t c_value(void);
#ifdef __cplusplus
}
#endif
]=])
file(WRITE "${app}/cpp/nested/cvalue.c" "#include \"cvalue.h\"\nint32_t c_value(void){return _Generic(1, int: 23, default: 0);}\n")
file(WRITE "${app}/cpp/nested/plus.c++" "#include <cstdint>\nstd::int32_t plus_value(){return 4;}\n")
file(WRITE "${app}/cpp/nested/plus.hpp" "#pragma once\n#include <cstdint>\nstd::int32_t plus_value();\n")
file(WRITE "${app}/src/main.ar" "cpp \"nested/cvalue.h\";cpp \"nested/plus.hpp\";extern cpp fn cvalue()->i32=\"c_value\";extern cpp fn plus()->i32=\"plus_value\";fn main()->i32{unsafe{println(cvalue()+plus());}return 0;}")
command("${app}" 0 run)
if(NOT output STREQUAL "27\n")
  message(FATAL_ERROR "C11 and recursive C++ source discovery failed: ${output}")
endif()
command("${app}" 0 run --cxx-dir "${root}/outside output")
if(NOT output STREQUAL "27\n" OR NOT EXISTS "${root}/outside output/release/program.cpp")
  message(FATAL_ERROR "custom output directory failed")
endif()
command("${app}" 0 build --debug --cxx-dir "debug output")
if(NOT EXISTS "${app}/debug output/debug/app${suffix}")
  message(FATAL_ERROR "debug override failed")
endif()
command("${app}" 0 emit-cpp --cxx-dir "exported")
if(NOT EXISTS "${app}/exported/release/program.cpp")
  message(FATAL_ERROR "emit-cpp directory override failed")
endif()
command("${app}" 0 emit-cpp --stdout)
if(NOT output MATCHES "#include <nested/cvalue.h>")
  message(FATAL_ERROR "stdout export omitted native header")
endif()
command("${app}" 0 emit-cpp -o "${root}/explicit.cpp")
command("${app}" 1 emit-cpp -o cpp/demo.hpp)
command("${app}" 1 emit-cpp -o Argon.toml)
command("${app}" 1 build --cxx-dir cpp)
command("${app}" 1 build --cxx-dir src)
command("${app}" 1 build --cxx-dir .)
command("${app}" 1 build --cxx-dir)
command("${app}" 1 check --cxx-dir elsewhere)
command("${app}" 1 build --stdout)
command("${app}" 1 emit-cpp --stdout -o unused.cpp)
command("${app}" 1 emit-cpp --cxx-dir elsewhere -o unused.cpp)
# Failed native builds preserve both last successful artifacts.
file(SHA256 "${app}/argon-cxx/release/app${suffix}" old_binary)
file(SHA256 "${app}/argon-cxx/release/program.cpp" old_cpp)
file(WRITE "${app}/cpp/nested/cvalue.c" "invalid C source")
command("${app}" 1 build)
file(SHA256 "${app}/argon-cxx/release/app${suffix}" new_binary)
file(SHA256 "${app}/argon-cxx/release/program.cpp" new_cpp)
if(NOT old_binary STREQUAL new_binary OR NOT old_cpp STREQUAL new_cpp)
  message(FATAL_ERROR "failed native build overwrote a previous artifact")
endif()
# A persisted project-relative output directory also works from src/.
command("${root}" 0 new custom --cxx-dir "generated code")
command("${root}/custom/src" 0 build)
command("${root}/custom" 0 emit-cpp)
if(NOT EXISTS "${root}/custom/generated code/release/program.cpp" OR NOT EXISTS "${root}/custom/generated code/release/custom${suffix}" OR EXISTS "${root}/custom/argon-cxx")
  message(FATAL_ERROR "persistent output setting failed")
endif()
file(MAKE_DIRECTORY "${root}/initialized")
command("${root}/initialized" 0 init --cxx-dir generated)
command("${root}/initialized" 0 run)
if(NOT EXISTS "${root}/initialized/cpp" OR NOT EXISTS "${root}/initialized/generated/release/program.cpp")
  message(FATAL_ERROR "init layout failed")
endif()
# Standard include lookup is deferred to the native compiler; checks work offline.
file(WRITE "${root}/custom/src/main.ar" "cpp \"nonexistent_header_for_argon_test.hpp\";fn main()->i32{return 0;}")
command("${root}/custom" 0 check)
command("${root}/custom" 1 build)
foreach(header IN ITEMS "../escape.hpp" "/absolute.hpp" "")
  file(WRITE "${root}/custom/src/main.ar" "cpp \"${header}\";fn main()->i32{return 0;}")
  command("${root}/custom" 1 check)
endforeach()
file(WRITE "${root}/custom/src/main.ar" "cpp <cmath>;fn main()->i32{return 0;}")
command("${root}/custom" 1 check)
file(WRITE "${root}/custom/src/main.ar" "fn main()->i32{cpp \"cmath\";return 0;}")
command("${root}/custom" 1 check)
# Pre-existing manifests that list native/ explicitly remain supported.
file(MAKE_DIRECTORY "${root}/legacy/native" "${root}/legacy/src")
file(WRITE "${root}/legacy/Argon.toml" "[project]\nschema = 1\nname = \"legacy\"\nentry = \"src/main.ar\"\n[cpp]\nheaders = [\"legacy.hpp\"]\nsources = [\"native/legacy.cpp\"]\ninclude_dirs = [\"native\"]\n")
file(WRITE "${root}/legacy/native/legacy.hpp" "#include <cstdint>\nstd::int32_t legacy();\n")
file(WRITE "${root}/legacy/native/legacy.cpp" "#include \"legacy.hpp\"\nstd::int32_t legacy(){return 42;}\n")
file(WRITE "${root}/legacy/src/main.ar" "extern cpp fn legacy()->i32=\"legacy\";fn main()->i32{unsafe{println(legacy());}return 0;}")
command("${root}/legacy" 0 run)
if(NOT output STREQUAL "42\n")
  message(FATAL_ERROR "legacy manifest compatibility failed")
endif()
